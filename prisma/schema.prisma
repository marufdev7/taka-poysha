generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  HouseholdMember[]
  accounts     Account[]
  transactions Transaction[]
  debts        Debt[]
}

model Household {
  id           String            @id @default(cuid())
  name         String
  currency     String            @default("BDT")
  inviteCode   String            @unique @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  members      HouseholdMember[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  aiReports    AiReport[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  role        String    @default("MEMBER") // ADMIN, MEMBER, VIEW_ONLY
  joinedAt    DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  name           String        // "ক্যাশ", "bKash", "Nagad", "City Bank"
  type           String        @default("CASH") // CASH, BKASH, NAGAD, BANK, OTHER
  balance        Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  transfersTo    Transaction[] @relation("TransferToAccount")
}

model Category {
  id           String        @id @default(cuid())
  householdId  String?
  name         String        // "বেতন", "বাজার", "বাসা ভাড়া", etc.
  type         String        // "INCOME", "EXPENSE"
  icon         String?       // Lucide icon name, e.g. "ShoppingCart", "Briefcase", "Home"
  color        String?       // e.g. "#10b981", "#ef4444"
  createdAt    DateTime      @default(now())
  household    Household?    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  accountId   String
  toAccountId String?   // For wallet transfers
  categoryId  String?
  type        String    // "INCOME", "EXPENSE", "TRANSFER"
  amount      Float
  date        DateTime  @default(now())
  note        String?
  visibility  String    @default("FAMILY") // "FAMILY" (পরিবার দেখবে), "PRIVATE" (শুধু আমি দেখব)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  toAccount   Account?  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Budget {
  id          String    @id @default(cuid())
  householdId String
  categoryId  String
  month       String    // "2026-10" (YYYY-MM format)
  limitAmount Float
  createdAt   DateTime  @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, month])
}

model AiReport {
  id          String     @id @default(cuid())
  householdId String?
  userId      String?
  month       String     // "2026-10"
  summaryData String     // JSON representation of the calculated metrics
  content     String     // AI insights & advice in Bengali
  createdAt   DateTime   @default(now())

  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Debt {
  id          String    @id @default(cuid())
  userId      String
  householdId String?
  personName  String    // ব্যক্তির নাম (যেমন: "আসিফ", "সুমন", "বাড়িওয়ালা")
  type        String    // "RECEIVABLE" (আমি পাব) | "PAYABLE" (আমাকে দিতে হবে)
  amount      Float     // টাকার পরিমাণ
  dueDate     DateTime  // কোন তারিখে টাকা দিতে বা পাওয়া যাবে
  status      String    @default("PENDING") // "PENDING", "SETTLED"
  note        String?   // বিবরণ / কারণ
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
